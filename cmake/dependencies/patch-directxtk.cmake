file(READ "${SOURCE_DIR}/CMakeLists.txt" content)
set(original "CompileShaders.cmd ARGS")
set(replacement "bash \"${LAUNCHER}\"")
string(FIND "${content}" "${replacement}" patched)
if(patched EQUAL -1)
    string(FIND "${content}" "${original}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "DirectXTK shader command no longer matches the pinned source.")
    endif()
    string(REPLACE "${original}" "${replacement}" content "${content}")
    file(WRITE "${SOURCE_DIR}/CMakeLists.txt" "${content}")
endif()
